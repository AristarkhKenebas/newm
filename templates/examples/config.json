{
  "background": { "path": "resource:wallpaper.jpg", "anim": true },
  "corner_radius": 24,
  "anim_time": 0.3,
  "view": { "corner_radius": 24, "padding": 8 },
  "rules": [
    { "app_id": "pavucontrol", "float": true },
    { "app_id": "mpv", "float": true },
    { "app_id": "imv", "float": true },
    { "app_id": "Alacritty", "blur": { "radius": 6, "passes": 4 } },
    { "app_id": "foot", "blur": { "radius": 6, "passes": 4 } }
  ],
  "focus": { "enabled": true, "color": "#E5E9F0AA", "distance": 4, "width": 2 },
  "panels": {
    "top_bar": { "enabled": true, "height": 32, "margin": 6, "corner_radius": 12, "theme": "auto",
                 "left": ["wall", "window"], "center": ["clock"], "right": ["tray", "network", "volume", "battery", "power"],
                 "clock": "HH:mm", "date": "EEE d MMM" },
    "lock": { "w": 0.6, "h": 0.6, "corner_radius": 32 },
    "launcher": { "w": 0.7, "h": 0.7, "corner_radius": 24 }
  },
  "keyboard": { "layouts": "us" },
  "input": { "tap_to_click": true, "natural_scroll": false, "focus_follows_mouse": false },
  "keys": {
    "L-Return": "terminal",
    "L-d": "enter_launcher_overlay",
    "L-h": "move -1 0", "L-j": "move 0 1", "L-k": "move 0 -1", "L-l": "move 1 0",
    "L-Left": "move -1 0", "L-Down": "move 0 1", "L-Up": "move 0 -1", "L-Right": "move 1 0",
    "L-t": "move_in_stack 1",
    "L-Tab": "cycle_views 1", "L-S-Tab": "cycle_views -1",
    "L-S-h": "move_focused_view -1 0", "L-S-j": "move_focused_view 0 1", "L-S-k": "move_focused_view 0 -1", "L-S-l": "move_focused_view 1 0",
    "L-C-h": "resize_focused_view -1 0", "L-C-j": "resize_focused_view 0 1", "L-C-k": "resize_focused_view 0 -1", "L-C-l": "resize_focused_view 1 0",
    "L-u": "basic_scale 1", "L-n": "basic_scale -1",
    "L-": "toggle_overview",
    "L-q": "close_focused_view",
    "L-f": "toggle_fullscreen",
    "L-space": "toggle_focused_view_floating",
    "L-p": "ensure_locked dim=true",
    "L-C": "update_config",
    "L-S-Escape": "terminate",
    "XF86MonBrightnessUp": "brightness +5", "XF86MonBrightnessDown": "brightness -5",
    "XF86AudioRaiseVolume": "volume +5", "XF86AudioLowerVolume": "volume -5",
    "XF86AudioMute": "volume mute", "XF86AudioMicMute": "mic-mute",
    "Print": "launch grim"
  },
  "startup": [],
  "energy": { "idle_times": [120, 300, 600] }
}
